// Stock vendor.xiaomi.hardware.misys.common (hypsys_vendor), reconstructed from the MiuiCamera Java stub (same
// descriptors and transaction codes). Own module name: no clash with stock vendor.xiaomi.hardware.misys.common-V*-ndk.
aidl_interface {
    name: "vendor.xiaomi.hardware.misys.compat",
    vendor_available: true,
    srcs: ["vendor/xiaomi/hardware/misys/common/*.aidl"],
    stability: "vintf",
    owner: "xiaomi",
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}
