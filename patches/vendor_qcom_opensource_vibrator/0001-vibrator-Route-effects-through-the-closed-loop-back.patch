From e1d2b30a6a2645efde70c915b0afe405f6ce75b9 Mon Sep 17 00:00:00 2001
From: turbo-boo <59400127+turbo-boo@users.noreply.github.com>
Date: Tue, 30 Jun 2026 09:29:22 +0900
Subject: [PATCH] vibrator: Route effects through the closed-loop backend

Change-Id: Ic407157a400ccbc9f867991596ad0ae5c415097f
---
 aidl/HapticsPolicy.xml     |  8 ++++----
 aidl/VibratorCL/Android.bp | 16 ++++++++--------
 2 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/aidl/HapticsPolicy.xml b/aidl/HapticsPolicy.xml
index 5dfe77f..ed55227 100644
--- a/aidl/HapticsPolicy.xml
+++ b/aidl/HapticsPolicy.xml
@@ -38,16 +38,16 @@
 <hapticsPolicyConfiguration>
     <!--If timeout <= maxMs, then OL else CL -->
     <hapticsONAPI>
-        <maxMs>3000</maxMs>
+        <maxMs>0</maxMs>
     </hapticsONAPI>
     <!--Following effects are supported by OL, remaining by CL-->
     <hapticsPerformAPI>
-    <!-- 0 - CLICK, 1 - DOUBLE_CLICK, 2 - TICK, 3 - THUD, 4 - POP, 5 - HEAVY_CLICK-->
-        <effect_id>0,1,2,3,4,5</effect_id>
+    <!-- Empty list means all effects route to CL for higher intensity -->
+        <effect_id></effect_id>
     </hapticsPerformAPI>
     <!--If support == True, then OL else CL-->
     <hapticsComposeAPI>
-        <SupportCompose>True</SupportCompose>
+        <SupportCompose>False</SupportCompose>
     </hapticsComposeAPI>
     <!--If support == True, then OL else CL-->
     <hapticsComposePwleAPI>
diff --git a/aidl/VibratorCL/Android.bp b/aidl/VibratorCL/Android.bp
index d220a94..06b77e2 100644
--- a/aidl/VibratorCL/Android.bp
+++ b/aidl/VibratorCL/Android.bp
@@ -6,11 +6,11 @@ cc_library_shared {
     cflags: COMMON_CFLAGS,
     vendor: true,
     srcs: ["Vibrator.cpp"],
-    header_libs: select(soong_config_variable("qti_vibrator", "libpalclient_namespace"), {
-        any @ value: [
-            "//" + value + ":libspf-headers",
-            "//" + value + ":libarosal_headers",
-            "//" + value + ":libarpal_headers",
+    header_libs: select(soong_config_variable("qti_vibrator", "use_libpalclient"), {
+        true: [
+            "libspf-headers",
+            "libarosal_headers",
+            "libarpal_headers",
         ],
         default: [],
     }),
@@ -19,8 +19,8 @@ cc_library_shared {
         "android.hardware.vibrator-V2-ndk",
         "libbinder_ndk",
         "liblog",
-    ] + select(soong_config_variable("qti_vibrator", "libpalclient_namespace"), {
-        any @ value: ["//" + value + ":libpalclient"],
+    ] + select(soong_config_variable("qti_vibrator", "use_libpalclient"), {
+        true: ["libpalclient"],
         default: [],
     }),
-}
\ No newline at end of file
+}
