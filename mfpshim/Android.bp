// libmfpshim: DT_NEEDED shim for the stock Xiaomi mfp-daemon (see mfpshim.cpp)
cc_library_shared {
    name: "libmfpshim",
    vendor: true,
    srcs: ["mfpshim.cpp"],
    version_script: "libmfpshim.map.txt",
    shared_libs: [
        "libbinder_ndk",
        "libdl",
        "liblog",
        "android.hardware.biometrics.fingerprint-V5-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.keymaster-V4-ndk",
    ],
    cflags: ["-Wall", "-Werror"],
}
