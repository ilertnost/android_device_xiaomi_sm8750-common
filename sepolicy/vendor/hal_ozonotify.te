type hal_ozonotify_default, domain;
type hal_ozonotify_default_exec, exec_type, file_type, vendor_file_type;
type hal_ozonotify_service, hal_service_type, protected_service, service_manager_type;

binder_use(hal_ozonotify_default)
hal_server_domain(hal_ozonotify_default, hal_ozonotify)
init_daemon_domain(hal_ozonotify_default)

allow hal_ozonotify_server hal_ozonotify_service:service_manager { add find };
allow hal_ozonotify_client hal_ozonotify_service:service_manager find;

allow platform_app hal_ozonotify_service:service_manager find;
binder_call(platform_app, hal_ozonotify_server)
binder_call(hal_ozonotify_server, platform_app)

allow hal_audio_default hal_ozonotify_service:service_manager find;
binder_call(hal_audio_default, hal_ozonotify_server)
binder_call(hal_ozonotify_server, hal_audio_default)

allow mediaserver hal_ozonotify_service:service_manager find;
binder_call(mediaserver, hal_ozonotify_server)

allow priv_app hal_ozonotify_service:service_manager find;

binder_call(dumpstate, hal_ozonotify_server)
allow hal_ozonotify_server dumpstate:fifo_file write;
