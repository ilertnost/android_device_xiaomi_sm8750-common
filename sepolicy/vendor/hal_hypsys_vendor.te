type hal_hypsys_vendor, domain;
type hal_hypsys_vendor_exec, exec_type, vendor_file_type, file_type;

type hal_hypsys_vendor_service, hal_service_type, service_manager_type;

binder_use(hal_hypsys_vendor)
init_daemon_domain(hal_hypsys_vendor)
hal_client_domain(hal_hypsys_vendor, hal_misyscore)

allow hal_hypsys_vendor hal_hypsys_vendor_service:service_manager { add find };
allow hal_hypsys_vendor hal_misys_service:service_manager { add find };
allow hal_hypsys_vendor hal_misyscore_service:service_manager find;
allow hal_hypsys_vendor hal_hypsys_vendor:binder call;

# Camera passes watermark payloads to HypSys through shared-memory FDs.
allow hal_hypsys_vendor platform_app:fd use;
allow hal_hypsys_vendor appdomain_tmpfs:file { getattr map read };

get_prop(hal_hypsys_vendor, boot_status_prop)
get_prop(hal_hypsys_vendor, vendor_camera_sensor_prop)
get_prop(hal_hypsys_vendor, vendor_fp_prop)
get_prop(hal_hypsys_vendor, vendor_wifi_version)

# MiSys common service also owns the stock crash, charger-log and hardware
# information collectors. Keep access limited to their labelled endpoints.
allow hal_hypsys_vendor block_device:dir r_dir_perms;
allow hal_hypsys_vendor blackbox_block_device:blk_file rw_file_perms;
allow hal_hypsys_vendor kmsg_device:chr_file rw_file_perms;
allow hal_hypsys_vendor kernel:system syslog_read;
allow hal_hypsys_vendor minidump_block_device:blk_file rw_file_perms;
allow hal_hypsys_vendor minidump_data_file:dir create_dir_perms;
allow hal_hypsys_vendor minidump_data_file:file create_file_perms;
allow hal_hypsys_vendor proc_tp_file:file r_file_perms;
allow hal_hypsys_vendor proc_tp_lockdown:file r_file_perms;
allow hal_hypsys_vendor self:netlink_kobject_uevent_socket { bind create read setopt };
allow hal_hypsys_vendor sysfs_bootinfo:dir r_dir_perms;
allow hal_hypsys_vendor sysfs_bootinfo:file rw_file_perms;
allow hal_hypsys_vendor sysfs_wake_lock:file rw_file_perms;
allow hal_hypsys_vendor vendor_camera_proc:file r_file_perms;
allow hal_hypsys_vendor vendor_bsp_data_log_file:dir create_dir_perms;
allow hal_hypsys_vendor vendor_bsp_data_log_file:file create_file_perms;
allow hal_hypsys_vendor vendor_sysfs_displayfeature:dir r_dir_perms;
allow hal_hypsys_vendor vendor_sysfs_displayfeature:file r_file_perms;
allow hal_hypsys_vendor vendor_sysfs_battery_supply:dir r_dir_perms;
allow hal_hypsys_vendor vendor_sysfs_battery_supply:file r_file_perms;
allow hal_hypsys_vendor vendor_sysfs_hardwareinfo:file rw_file_perms;
allow hal_hypsys_vendor vendor_sysfs_qcom_battery:dir r_dir_perms;
allow hal_hypsys_vendor vendor_sysfs_qcom_battery:file r_file_perms;
allow hal_hypsys_vendor vendor_sysfs_soc_sensitive:file r_file_perms;
allow hal_hypsys_vendor vendor_sysfs_xm_power:dir r_dir_perms;
allow hal_hypsys_vendor vendor_sysfs_xm_power:file rw_file_perms;
allow hal_hypsys_vendor vfat:dir search;

# MiSys copies camera watermark assets into the vendor camera data store.
allow hal_hypsys_vendor vendor_camera_data_file:dir create_dir_perms;
allow hal_hypsys_vendor vendor_camera_data_file:file create_file_perms;
