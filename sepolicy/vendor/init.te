set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, vendor_deviceid_prop)
set_prop(vendor_init, vendor_displayfeature_prop)
set_prop(vendor_init, vendor_mischeck_prop)
set_prop(vendor_init, vendor_qcc_prop)
set_prop(vendor_init, vendor_radio_prop)
set_prop(vendor_init, vendor_ssr_prop)
set_prop(vendor_init, vendor_thermal_normal_prop)
set_prop(vendor_init, vendor_touchfeature_prop)

allow vendor_init minidump_data_file:dir create_dir_perms;
allow vendor_init minidump_data_file:file create_file_perms;

allow init nfc:binder call;

# vendor_init needs to set fingerprint properties
set_prop(vendor_init, vendor_fp_prop)

# Silence denials for bluetooth_prop and radio_prop (neverallow prevents access)
dontaudit vendor_init bluetooth_prop:property_service set;
dontaudit vendor_init radio_prop:file read;

# init needs to mount tracefs
allow init debugfs_tracing_debug:dir mounton;

# Lineage Health charging control - allow init to chown cc_toggle
allow vendor_init vendor_sysfs_qcom_battery:dir search;
allow vendor_init vendor_sysfs_qcom_battery:file setattr;
allow vendor_init vendor_sysfs_qcom_battery:lnk_file { getattr read };