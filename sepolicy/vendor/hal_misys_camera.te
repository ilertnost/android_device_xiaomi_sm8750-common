# MiSys file service used by MiuiCamera. Access is confined to the camera
# application's files below /data/vendor/camera.
type hal_misys_camera_default, domain;
hal_server_domain(hal_misys_camera_default, hal_misys_camera)

type hal_misys_camera_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_misys_camera_default)
binder_use(hal_misys_camera_default)

type hal_misys_camera_service, hal_service_type, protected_service, service_manager_type;
add_service(hal_misys_camera_default, hal_misys_camera_service)

allow { platform_app platform_app_36 } hal_misys_camera_service:service_manager find;
binder_call({ platform_app platform_app_36 }, hal_misys_camera_default)

allow hal_misys_camera_default { platform_app platform_app_36 }:fd use;
allow hal_misys_camera_default appdomain_tmpfs:file { getattr map read write };

allow hal_misys_camera_default vendor_camera_data_file:dir create_dir_perms;
allow hal_misys_camera_default vendor_camera_data_file:file create_file_perms;
