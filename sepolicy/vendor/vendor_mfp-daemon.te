# vendor_mfp-daemon - Xiaomi stock fingerprint daemon
type vendor_mfp-daemon, domain;
type vendor_mfp-daemon_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_mfp-daemon)

# AIDL fingerprint HAL
binder_use(vendor_mfp-daemon)
binder_call(vendor_mfp-daemon, system_server)
binder_call(vendor_mfp-daemon, servicemanager)
hal_server_domain(vendor_mfp-daemon, hal_fingerprint)
hal_client_domain(vendor_mfp-daemon, vendor_hal_perf)

# Fingerprint device access
allow vendor_mfp-daemon vendor_fingerprint_device:chr_file rw_file_perms;
allow vendor_mfp-daemon vendor_qbt_device:chr_file rw_file_perms;
allow vendor_mfp-daemon vendor_miev_device:chr_file rw_file_perms;
allow vendor_mfp-daemon vendor_displayfeature_device:chr_file {
    ioctl
    open
    read
    write
};
allow vendor_mfp-daemon uhid_device:chr_file rw_file_perms;
allow vendor_mfp-daemon input_device:dir r_dir_perms;
allow vendor_mfp-daemon input_device:chr_file rw_file_perms;

# TEE/TrustZone access
allow vendor_mfp-daemon tee_device:chr_file rw_file_perms;
allow vendor_mfp-daemon vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
allow vendor_mfp-daemon vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;

# Data directories
allow vendor_mfp-daemon vendor_fingerprint_data_file:dir create_dir_perms;
allow vendor_mfp-daemon vendor_fingerprint_data_file:file create_file_perms;
allow vendor_mfp-daemon fingerprint_vendor_data_file:dir create_dir_perms;
allow vendor_mfp-daemon fingerprint_vendor_data_file:file create_file_perms;

# Persist partition
allow vendor_mfp-daemon mnt_vendor_file:dir search;
allow vendor_mfp-daemon vendor_persist_file:dir search;

# Sysfs access
allow vendor_mfp-daemon sysfs:file { read write open };
allow vendor_mfp-daemon sysfs_touch_hostprocess:file { open read };
allow vendor_mfp-daemon sysfs_tp_fodstatus:file { open read };
allow vendor_mfp-daemon vendor_sysfs_graphics:dir r_dir_perms;
allow vendor_mfp-daemon vendor_sysfs_graphics:file rw_file_perms;

# Socket for fpsensor
allow vendor_mfp-daemon vendor_mfp-daemon:unix_stream_socket { create bind listen accept read write };

# Properties
get_prop(vendor_mfp-daemon, vendor_panel_info_prop)
get_prop(vendor_mfp-daemon, vendor_sensors_prop)
set_prop(vendor_mfp-daemon, vendor_fp_prop)

# Capabilities
allow vendor_mfp-daemon self:capability { sys_nice };
allow vendor_mfp-daemon self:capability2 { block_suspend wake_alarm };
allow vendor_mfp-daemon self:netlink_socket create_socket_perms_no_ioctl;

# Binder calls
allow vendor_mfp-daemon surfaceflinger:binder { call transfer };
allow vendor_mfp-daemon platform_app:binder { call transfer };
allow vendor_mfp-daemon platform_app:fd use;
allow vendor_mfp-daemon system_app:binder { call transfer };
allow vendor_mfp-daemon system_app:fd use;

# SPSS access
allow vendor_mfp-daemon vendor_sysfs_spss:dir search;
allow vendor_mfp-daemon vendor_sysfs_spss:file { open read };
