# vendor_mfp-daemon - Xiaomi stock fingerprint daemon
type vendor_mfp-daemon, domain;
type vendor_mfp-daemon_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_mfp-daemon)

# AIDL fingerprint HAL
binder_use(vendor_mfp-daemon)
binder_call(vendor_mfp-daemon, system_server)
binder_call(vendor_mfp-daemon, servicemanager)
hal_server_domain(vendor_mfp-daemon, hal_fingerprint)

# Fingerprint device access
allow vendor_mfp-daemon vendor_fingerprint_device:chr_file rw_file_perms;
allow vendor_mfp-daemon uhid_device:chr_file rw_file_perms;
allow vendor_mfp-daemon input_device:dir r_dir_perms;
allow vendor_mfp-daemon input_device:chr_file rw_file_perms;

# TEE/TrustZone access
allow vendor_mfp-daemon tee_device:chr_file rw_file_perms;
allow vendor_mfp-daemon vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
allow vendor_mfp-daemon vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;

# Data directories
allow vendor_mfp-daemon vendor_fingerprint_data_file:dir create_dir_perms;
allow vendor_mfp-daemon vendor_fingerprint_data_file:file create_file_perms;
allow vendor_mfp-daemon fingerprint_vendor_data_file:dir create_dir_perms;
allow vendor_mfp-daemon fingerprint_vendor_data_file:file create_file_perms;

# Persist partition
allow vendor_mfp-daemon mnt_vendor_file:dir search;
allow vendor_mfp-daemon vendor_persist_file:dir search;

# Sysfs access
allow vendor_mfp-daemon sysfs:file { read write open };
allow vendor_mfp-daemon vendor_sysfs_graphics:dir r_dir_perms;
allow vendor_mfp-daemon vendor_sysfs_graphics:file rw_file_perms;

# Socket for fpsensor
allow vendor_mfp-daemon vendor_mfp-daemon:unix_stream_socket { create bind listen accept read write };

# Properties
get_prop(vendor_mfp-daemon, vendor_panel_info_prop)
set_prop(vendor_mfp-daemon, vendor_fp_prop)

# Capabilities
allow vendor_mfp-daemon self:capability { sys_nice };
allow vendor_mfp-daemon self:netlink_socket create_socket_perms_no_ioctl;

# Binder calls
allow vendor_mfp-daemon surfaceflinger:binder { call transfer };
allow vendor_mfp-daemon platform_app:binder { call transfer };
allow vendor_mfp-daemon platform_app:fd use;
allow vendor_mfp-daemon system_app:binder { call transfer };
allow vendor_mfp-daemon system_app:fd use;

# SPSS access
allow vendor_mfp-daemon vendor_sysfs_spss:dir search;
allow vendor_mfp-daemon vendor_sysfs_spss:file { open read };

# v4: allow rules of the stock OS4.0.0.7 vendor_sepolicy.cil for vendor_mfp-daemon
# (only types that exist in our policy; subject vendor_mfp-daemon; execute perms dropped)
allow vendor_mfp-daemon surfaceflinger:binder { transfer };
allow vendor_mfp-daemon priv_app:binder { transfer };
allow vendor_mfp-daemon system_app:binder { transfer };
allow vendor_mfp-daemon system_server:binder { transfer };
allow vendor_mfp-daemon vendor_mfp-daemon_exec:file { read getattr map open entrypoint };
allow vendor_mfp-daemon tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mfp-daemon vendor_hal_perf_hwservice:hwservice_manager { find };
allow vendor_mfp-daemon vendor_hal_perf_default:binder { call };
allow vendor_mfp-daemon firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mfp-daemon firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon mnt_vendor_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mfp-daemon mnt_vendor_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon mnt_vendor_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon vendor_persist_qti_fp_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mfp-daemon vendor_persist_qti_fp_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon vendor_persist_qti_fp_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon self:cap_userns { sys_nice };
allow vendor_mfp-daemon vendor_fingerprint_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_mfp-daemon vendor_fingerprint_data_file:dir { getattr };
allow vendor_mfp-daemon vendor_fingerprint_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_mfp-daemon vendor_fingerprint_data_file_fpdump:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_mfp-daemon vendor_fingerprint_data_file_fpdump:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_mfp-daemon vendor_fp_prop:file { read getattr map open };
allow vendor_mfp-daemon vendor_fp_prop:property_service { set };
allow vendor_mfp-daemon vendor_panel_info_prop:file { read getattr map open };
allow vendor_mfp-daemon platform_app:fd { use };
allow vendor_mfp-daemon platform_app:binder { transfer };
allow vendor_mfp-daemon system_app:fd { use };
allow vendor_mfp-daemon priv_app:binder { call transfer };
allow vendor_mfp-daemon sysfs:file { write };
allow vendor_mfp-daemon vendor_sysfs_spss:dir { search };
allow vendor_mfp-daemon vendor_sysfs_spss:file { read open };
allow vendor_mfp-daemon mnt_vendor_file:file { write open };
allow vendor_mfp-daemon mnt_vendor_file:dir { write };
allow vendor_mfp-daemon uhid_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mfp-daemon vendor_sysfs_graphics:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mfp-daemon vendor_sysfs_graphics:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mfp-daemon vendor_sysfs_displayfeature:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mfp-daemon vendor_sysfs_displayfeature:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mfp-daemon vendor_displayfeature_device:chr_file { ioctl read write open };
allow vendor_mfp-daemon input_device:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mfp-daemon input_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mfp-daemon mnt_vendor_file:dir { search };
allow vendor_mfp-daemon vendor_fingerprint_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mfp-daemon self:netlink_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_mfp-daemon vendor_spcomlib_prop:file { read getattr map open };
allow vendor_mfp-daemon vendor_tee_listener_prop:file { read getattr map open };
allow vendor_mfp-daemon vendor_spss_utils_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mfp-daemon vendor_skp_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mfp-daemon vendor_spcom_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mfp-daemon vendor_sp_keymaster_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mfp-daemon vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon sysfs_tp_fodstatus:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon sysfs_tp_fodstatus:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon sysfs_touch_hostprocess:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon sysfs_touch_hostprocess:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mfp-daemon vendor_qbt_device:chr_file { ioctl read write open };
allow vendor_mfp-daemon hal_touchfeature_xiaomi_default:binder { call transfer };
allow hal_touchfeature_xiaomi_default vendor_mfp-daemon:binder { transfer };
allow vendor_mfp-daemon hal_touchfeature_xiaomi_default:fd { use };
allow vendor_mfp-daemon servicemanager:binder { call transfer };
allow vendor_mfp-daemon vendor_hal_fingerprint_service_xiaomi:service_manager { add find };
allow vendor_mfp-daemon fwk_sensor_hwservice:hwservice_manager { find };
allow vendor_mfp-daemon fwk_sensor_service:service_manager { find };
allow vendor_mfp-daemon vendor_sysfs_battery_supply:dir { search };
allow vendor_mfp-daemon vendor_sysfs_battery_supply:file { read open };

# FOD touch mode via the Xiaomi touchfeature HAL (enrollment gets no touch-down in enforcing without it), perf boosts
hal_client_domain(vendor_mfp-daemon, hal_touchfeature_xiaomi)
hal_client_domain(vendor_mfp-daemon, vendor_hal_perf)
